#-------APP settings-------
APP_NAME=VITA API
APP_DESCRIPTION=API de trazabilidad ganadera
APP_VERSION=0.1.0

#-------JWT settings-------
# Secreto para los JWT que emite/valida el provider LOCAL (desarrollo/test).
JWT_SECRET_KEY=cambiame-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
# Expiración del token del provider local, en minutos. No aplica a Supabase.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

#-------Supabase settings-------
# URL del proyecto: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Claves JWT legacy que usa el backend (Dashboard -> Project Settings -> API -> Project API keys)
SUPABASE_ANON_KEY=<anon-key-jwt>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-jwt>
# Secreto con el que Supabase firma los JWT (HS256).
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=<jwt-secret>

#-------Database-------
# Cadena de conexión canónica. En entornos reales: pooler transaccional de
# Supabase (Supavisor, puerto 6543). El backend desactiva el statement cache
# automáticamente cuando detecta "pooler.supabase.com" en la URL.
# OJO: caracteres especiales de la contraseña van URL-encodeados (p. ej. '?' -> %3F).
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres
# Fallback para un Postgres local (solo se usa si DATABASE_URL está vacío/ausente).
POSTGRES_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/vita

#-------Environment settings-------
# local | test | staging | production. Controla DEBUG y autocreación de tablas
# (LOCAL/TEST). NO elige la base de datos: eso lo hace DATABASE_URL/POSTGRES_URI.
ENVIRONMENT=local
# supabase | local. Elige el proveedor de autenticación. Si se omite, el default
# es "supabase" en production y "local" en el resto.
AUTH_PROVIDER=supabase
LOG_LEVEL=DEBUG
