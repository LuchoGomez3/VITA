ENVIRONMENT=local
APP_NAME=VITA API
APP_DESCRIPTION=API de trazabilidad ganadera
APP_VERSION=0.1.0

# Base de datos. DATABASE_URL es la cadena canónica (pooler de Supabase fuera de
# entornos locales); POSTGRES_URI queda como fallback para un Postgres local.
DATABASE_URL=
POSTGRES_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/vita

# JWT (provider local). En producción los tokens los emite Supabase.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Proveedor de autenticación: "supabase" | "local"
AUTH_PROVIDER=local

# Supabase (requeridos cuando AUTH_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

LOG_LEVEL=DEBUG
