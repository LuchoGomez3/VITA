ENVIRONMENT=local
APP_NAME=VITA API
APP_DESCRIPTION=API de trazabilidad ganadera
APP_VERSION=0.1.0

# Base de datos. DATABASE_URL es la cadena canónica (pooler de Supabase fuera de
# entornos locales); POSTGRES_URI queda como fallback para un Postgres local.
DATABASE_URL=
POSTGRES_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/vita

# JWT (provider local). En producción los tokens los emite Supabase.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Proveedor de autenticación: "supabase" | "local"
AUTH_PROVIDER=local

# Supabase (requeridos cuando AUTH_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Bucket privado con la foto de perfil de cada usuario (adr-0011).
SUPABASE_STORAGE_BUCKET_AVATARES=avatars

# Email saliente (invitaciones al equipo, adr-0012): "console" | "smtp".
# "console" solo loguea el mensaje (con el código) y es para desarrollo.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VITA <no-reply@example.com>
EMAIL_TIMEOUT_SECONDS=10

# Invitaciones al equipo
INVITACION_VIGENCIA_DIAS=7
# Clave del HMAC de los códigos. Obligatoria en staging/producción.
INVITACION_CODIGO_SECRETO=change-me
INVITACION_CODIGO_RATE_LIMIT=10
INVITACION_CODIGO_RATE_WINDOW_SECONDS=3600

LOG_LEVEL=DEBUG
