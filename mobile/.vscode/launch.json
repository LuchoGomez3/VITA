{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mobile: debug local backend",
      "request": "launch",
      "type": "dart",
      "cwd": ".",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=VITA_BACKEND_BASE_URL=http://10.0.2.2:8000"
      ]
    },
    {
      "name": "Mobile: debug physical device backend",
      "request": "launch",
      "type": "dart",
      "cwd": ".",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=VITA_BACKEND_BASE_URL=http://192.168.0.53:8000"
      ]
    },
    {
      "name": "Mobile: debug custom backend",
      "request": "launch",
      "type": "dart",
      "cwd": ".",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=VITA_BACKEND_BASE_URL=${input:vitaBackendBaseUrl}"
      ]
    },
    {
      "name": "Mobile: debug offline only",
      "request": "launch",
      "type": "dart",
      "cwd": ".",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=VITA_BACKEND_BASE_URL=http://10.0.2.2:8000"
      ]
    }
  ],
  "inputs": [
    {
      "id": "vitaBackendBaseUrl",
      "type": "promptString",
      "description": "URL base del backend VITA",
      "default": "http://192.168.0.53:8000"
    }
  ]
}
